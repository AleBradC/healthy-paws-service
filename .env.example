# =====================================================================
# Healthy Paws — Backend service environment template
# =====================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Runtime ----------------------------------------------------------
# Set to `production` on the EC2 box. Switches: cookies become Secure,
# Apollo introspection is disabled, CORS dev fallback is suppressed.
NODE_ENV=development
PORT=8080

# Number of reverse-proxy hops between the client and Express. Dev compose
# (nginx -> backend) = 1. Production (Cloudflare -> nginx -> backend) = 2.
# Wrong values break express-rate-limit bucketing.
TRUST_PROXY=1

# Comma-separated list of origins permitted to call the API.
# REQUIRED in production. Dev falls back to http://localhost:5173,3000.
# Production example: ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Public URL of the frontend, used in password-reset emails and similar.
# REQUIRED in production. Production example: https://yourdomain.com
FRONTEND_URL=http://localhost

# --- JWT --------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=healthy-paws
JWT_AUDIENCE=healthy-paws-client

# --- Postgres ---------------------------------------------------------
# DB_HOST is overridden to `db` by docker-compose when running the stack.
DB_HOST=localhost
DB_PORT=5432
DB_USER=healthy_paws
DB_PASSWORD=change-me-strong-password
DB_DATABASE=healthy_paws
# Pool size cap; default 8 fits a t3.micro Postgres comfortably.
DB_POOL_MAX=8
# Set to `true` only for managed Postgres (RDS, Neon). In-compose loopback
# Postgres does not need SSL.
DATABASE_SSL=false

# --- Email (Resend) --------------------------------------------------
# Resend SMTP API key. Get one free at https://resend.com (3 000 emails/mo).
# If left UNSET, the backend falls back to a stdout-only "log emails" mode —
# verification + reset emails appear in `docker compose logs backend` instead
# of being delivered. Handy for local dev without an external account.
# REQUIRED in production.
RESEND_API_KEY=

# Sender address shown in the From: header. The sandbox value below works
# day-1 with no DNS setup. To send from your own domain, verify it in the
# Resend dashboard (4 DNS records) and replace this with you@yourdomain.com.
MAIL_FROM=onboarding@resend.dev

# --- App-level email config ------------------------------------------
APP_NAME=Healthy Paws
PASSWORD_RESET_EXPIRES_MINUTES=30

# --- Body parser limits (optional) -----------------------------------
# BODY_LIMIT_JSON=100kb
# BODY_LIMIT_URLENCODED=100kb
# URLENCODED_PARAMETER_LIMIT=1000
