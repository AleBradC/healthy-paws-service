# =====================================================================
# Healthy Paws — Backend service environment template
# =====================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Runtime ----------------------------------------------------------
NODE_ENV=development
PORT=8080

# Comma-separated list of origins permitted to call the API.
# REQUIRED in production. Dev falls back to http://localhost:5173,3000.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Public URL of the frontend, used in password-reset emails and similar.
# REQUIRED in production.
FRONTEND_URL=http://localhost

# --- JWT --------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=healthy-paws
JWT_AUDIENCE=healthy-paws-client

# --- Postgres ---------------------------------------------------------
# DB_HOST is overridden to `db` by docker-compose when running the stack.
DB_HOST=localhost
DB_PORT=5432
DB_USER=healthy_paws
DB_PASSWORD=change-me-strong-password
DB_DATABASE=healthy_paws

# --- Email (nodemailer / SMTP) ---------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey-or-smtp-user
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com

# --- App-level email config ------------------------------------------
APP_NAME=Healthy Paws
PASSWORD_RESET_EXPIRES_MINUTES=30

# --- Body parser limits (optional) -----------------------------------
# BODY_LIMIT_JSON=100kb
# BODY_LIMIT_URLENCODED=100kb
# URLENCODED_PARAMETER_LIMIT=1000
